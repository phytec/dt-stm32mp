/dts-v1/;

#include <dt-bindings/clock/stm32mp25-clksrc.h>
#include "stm32mp257.dtsi"
#include "stm32mp23xc.dtsi"
#include "stm32mp235c-phyflex-fpsc-g-som-m33td-rcc.dtsi"
#include "stm32mp25-lpddr4-1x16Gbits-1x32bits-1200MHz.dtsi"
#include "stm32mp25-lpddr4-alternate-1200MHz.dtsi"
#include "stm32mp25-ddr.dtsi"
#include "stm32mp25-ddr-alternate.dtsi"
#include "stm32mp25-pinctrl.dtsi"
#include "stm32mp25xxai-pinctrl.dtsi"
#include "stm32mp2-phyflex-fpsc-g-som-pinctrl.dtsi"

/ {
	model = "PHYTEC phyFLEX-STM32MP257F FPSC-Gamma SDCARD CM33TDCID";
	compatible = "phytec,stm32mp257f-phyflex-fpsc-g-som", "st,stm32mp257";

	aliases {
		serial0 = &usart2;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	cpu0_opp_table: cpu0-opp-table {
		compatible = "operating-points-v2";

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <800000>;
			opp-supported-hw = <0x3>;
			st,opp-default;
			st,pll = <&pll1_cfg_1200Mhz>;
		};
	};
};

&bsec {
	board_id: board_id@3d8 {
		reg = <0x3d8 0x4>;
	};
};

&cpu0 {
	operating-points-v2 = <&cpu0_opp_table>;
};

&sdmmc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1_b4_pins_c>;
	st,neg-edge;
	bus-width = <4>;
	status = "okay";
};

&usart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&usart2_pins_a>;
	status = "okay";
};
